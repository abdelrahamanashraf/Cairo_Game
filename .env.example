# GEMINI_API_KEY: Required for server-side Gemini / Lyria 3 music generation calls.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Provisioned Google Maps Platform key for Greater Cairo Tactical Map.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
